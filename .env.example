APP_NAME=LaravelApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pbn_automation_software
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when using HTTPS in production
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be greater than longest queue job timeout (domain status check uses up to ~180s)
DB_QUEUE_RETRY_AFTER=240

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ADMIN_AUTH_MODEL=App\Models\Admin

# Only for initial setup / seeding; do not use weak passwords on production
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Domain status checker history (parent + child rows per run)
DOMAIN_STATUS_CHECK_KEEP_LAST=5
DOMAIN_STATUS_CHECK_RETENTION_DAYS=7
DOMAIN_STATUS_CHECK_STALE_HOURS=24
DOMAIN_STATUS_CHECK_DELETE_CHUNK=25
DOMAIN_STATUS_CHECK_MAX_DELETES_PER_RUN=100

# HTTP timeouts (seconds) — increase if domains are slow or far away
DOMAIN_STATUS_CHECK_CHUNK_SIZE=8
DOMAIN_STATUS_CHECK_REQUEST_TIMEOUT=60
DOMAIN_STATUS_CHECK_CONNECT_TIMEOUT=20
DOMAIN_STATUS_CHECK_RETRY_REQUEST_TIMEOUT=90
DOMAIN_STATUS_CHECK_RETRY_CONNECT_TIMEOUT=25
DOMAIN_STATUS_CHECK_JOB_TIMEOUT=180

# Remote plugin manager (dashboard-hosted ZIPs)
PLUGIN_MANAGER_MAX_DOMAINS=500
PLUGIN_MANAGER_MAX_ZIP_MB=5
PLUGIN_MANAGER_CHUNK_SIZE=2
PLUGIN_MANAGER_REQUEST_TIMEOUT=180
PLUGIN_MANAGER_SIGNING_KEY=
PLUGIN_MANAGER_DOWNLOAD_TTL_HOURS=24

# Webhook secret auto-rotation (default for new installs; change in admin UI: Domains → Webhook Secrets)
WEBHOOK_SECRET_ROTATION_HOURS=8
WEBHOOK_SECRET_ROTATION_MAX_HOURS=168