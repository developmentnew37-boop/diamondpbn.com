DROP TABLE IF EXISTS `articles`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `articles` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(255) NOT NULL,
  `name_normalized` varchar(255) DEFAULT NULL,
  `slug` varchar(255) NOT NULL,
  `description` longtext DEFAULT NULL,
  `search_text` longtext DEFAULT NULL,
  `article_category_id` bigint(20) unsigned DEFAULT NULL,
  `article_language_id` bigint(20) unsigned DEFAULT NULL,
  `type` tinyint(4) NOT NULL COMMENT '0=manual, 1=file_upload, 2=ai_generated',
  `status` tinyint(4) NOT NULL DEFAULT 0 COMMENT '0=unused, 1=used, 2=archived',
  `lock_at` timestamp NULL DEFAULT NULL,
  `expires_at` timestamp NULL DEFAULT NULL,
  `admin_id` bigint(20) unsigned NOT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
