  KEY `articles_admin_id_lock_at_deleted_at_index` (`admin_id`,`lock_at`,`deleted_at`),
  KEY `idx_articles_admin_lock_deleted` (`admin_id`,`lock_at`,`deleted_at`),
  KEY `idx_articles_language_status` (`article_language_id`,`status`),
  KEY `idx_articles_status_lock` (`status`,`lock_at`,`deleted_at`),
  FULLTEXT KEY `fulltext_title_content` (`name`,`description`),
  FULLTEXT KEY `fulltext_search_text` (`search_text`),
  CONSTRAINT `articles_admin_id_foreign` FOREIGN KEY (`admin_id`) REFERENCES `admins` (`id`) ON DELETE CASCADE,
  CONSTRAINT `articles_article_category_id_foreign` FOREIGN KEY (`article_category_id`) REFERENCES `article_categories` (`id`) ON DELETE SET NULL,
  CONSTRAINT `articles_article_language_id_foreign` FOREIGN KEY (`article_language_id`) REFERENCES `article_languages` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=242474 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
